{
    // Build/debug is driven by tasks.json + launch.json (Ctrl+Shift+B, F5),
    // which import the VS Developer environment themselves (scripts/vsenv.ps1).
    // These settings just keep the CMake Tools extension from fighting the
    // preset flow, and add a "VS Dev PowerShell" terminal for running
    // cmake/git by hand — it dot-sources scripts/vsenv.ps1 on open, so cmake
    // works there too (a plain terminal can't build: clang-cl needs the SDK).
    "cmake.useCMakePresets": "always",
    "cmake.configureOnOpen": false,

    "terminal.integrated.profiles.windows": {
        "VS Dev PowerShell": {
            "path": "powershell.exe",
            "icon": "tools",
            "args": [
                "-NoExit", "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-Command", ". '${workspaceFolder}\\scripts\\vsenv.ps1'"
            ]
        }
    },

    "files.associations": {
        "*.hpp": "cpp",
        "*.hlsl": "hlsl"
    },
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools"
}
