{
    // clang-cl produces MSVC-ABI binaries + PDBs, so debug with the Visual
    // Studio debugger (cppvsdbg). The current app takes no CLI args — it just
    // opens a window and clears the screen. Add args here once main() parses
    // them (e.g. a model path) again.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ToonEngine (Debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/windows-debug/ToonEngine.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "Build (Debug)"
        },
        {
            "name": "ToonEngine (Release)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/windows-release/ToonEngine.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "Build (Release)"
        }
    ]
}
