{
    // IntelliSense config so Diligent's bare-name includes ("EngineFactoryVk.h",
    // "RefCntAutoPtr.hpp", ...) resolve in the editor. The real include dirs are
    // propagated by CMake at build time; this recursive path just mirrors them
    // for the language server. Once CMake Tools has configured once, it also
    // feeds IntelliSense via configurationProvider (see settings.json).
    "version": 4,
    "configurations": [
        {
            "name": "Win32-clang-cl",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/external/DiligentCore/**",
                "${workspaceFolder}/external/DiligentTools/Imgui/interface",
                "${workspaceFolder}/external/DiligentTools/ThirdParty/imgui",
                "${workspaceFolder}/external/DiligentTools/ThirdParty/imgui/backends",
                "${workspaceFolder}/external/glfw/include"
            ],
            "defines": [
                "_WIN32",
                "UNICODE",
                "_UNICODE",
                "PLATFORM_WIN32=1",
                "ENGINE_DLL=1"
            ],
            "compilerPath": "C:/Program Files/LLVM/bin/clang-cl.exe",
            "intelliSenseMode": "windows-clang-x64",
            "cStandard": "c17",
            "cppStandard": "c++17"
        }
    ]
}
