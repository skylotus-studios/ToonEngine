# ToonEngine scene -- Level One (roadmap #19 level-transition demo).
#
# The scene ToonPlayer.exe loads with no arguments. "Ball" is a dynamic rigid body suspended
# above "Exit Door"; gravity drops it onto the door in under a second, the door's LevelExit
# script fires from OnCollisionEnter, and the engine fades to black and swaps to level_two.scene.
# The transition needs no input at all, which is what makes it verifiable from a screenshot.

camera.pivot 0.000000 1.000000 0.000000
camera.distance 14.000000
camera.yaw 0.000000
camera.pitch 0.250000
camera.fov 1.047200

entity "Scene"
  parent -1

entity "Sun"
  parent 0
  position 0.000000 6.000000 -4.000000
  rotation -0.684440 0.427860 0.000000 0.590380
  scale 1.000000 1.000000 1.000000
  light.color 1.000000 0.980000 0.920000
  light.intensity 1.000000

entity "Camera"
  parent 0
  position 0.000000 4.500000 -12.000000
  rotation 0.000000 0.000000 0.000000 1.000000
  scale 1.000000 1.000000 1.000000
  camera 1.047200 0.100000 100.000000 0 10.000000 1

entity "Ground"
  parent 0
  position 0.000000 0.000000 0.000000
  rotation 0.000000 0.000000 0.000000 1.000000
  scale 1.000000 1.000000 1.000000
  primitive plane 12.000000
  material.baseColor 0.290000 0.420000 0.350000
  material.outlineColor 0.060000 0.100000 0.080000
  material.outlineWidth 0.020000
  material.bands 4.000000
  material.ambient 0.250000
  material.roughness 0.800000
  collider box 12.000000 0.100000 12.000000

entity "Exit Door"
  parent 0
  position 0.000000 1.000000 0.000000
  rotation 0.000000 0.000000 0.000000 1.000000
  scale 1.000000 1.000000 1.000000
  primitive cube 1.000000
  material.baseColor 0.180000 0.720000 0.420000
  material.outlineColor 0.020000 0.140000 0.080000
  material.outlineWidth 0.035000
  material.bands 4.000000
  material.ambient 0.280000
  material.roughness 0.600000
  collider box 1.000000 1.000000 1.000000
  script LevelExit level_two.scene

entity "Ball"
  parent 0
  position 0.000000 6.000000 0.000000
  rotation 0.000000 0.000000 0.000000 1.000000
  scale 1.000000 1.000000 1.000000
  primitive sphere 0.500000 24 32
  material.baseColor 0.950000 0.650000 0.200000
  material.outlineColor 0.200000 0.100000 0.020000
  material.outlineWidth 0.030000
  material.bands 4.000000
  material.ambient 0.250000
  material.roughness 0.500000
  collider sphere 0.500000 0.000000 0.000000
  rigidbody dynamic 1.000000 0.500000 0.250000

entity "Landmark"
  parent 0
  position -4.500000 1.000000 2.000000
  rotation 0.000000 0.000000 0.000000 1.000000
  scale 1.000000 1.000000 1.000000
  primitive torus 1.000000 0.320000 32 48
  material.baseColor 0.850000 0.300000 0.350000
  material.outlineColor 0.180000 0.040000 0.060000
  material.outlineWidth 0.030000
  material.bands 4.000000
  material.ambient 0.250000
  material.roughness 0.500000
