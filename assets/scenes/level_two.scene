# ToonEngine scene -- Level Two (roadmap #19 level-transition demo).
#
# The destination default.scene transitions into. Deliberately different in palette, sky-facing
# angle, and layout so a screenshot tells the two apart at a glance, and deliberately does NOT
# auto-trigger: its own "Return Door" sits off to the side, so arriving here ends the demo
# instead of starting an endless ping-pong. Push "Ball" into the door with the gizmo (which works
# while Playing) to transition back.

camera.pivot 0.000000 1.000000 0.000000
camera.distance 14.000000
camera.yaw 0.000000
camera.pitch 0.250000
camera.fov 1.047200

entity "Scene"
  parent -1

entity "Sun"
  parent 0
  position 0.000000 6.000000 -4.000000
  rotation -0.684440 0.427860 0.000000 0.590380
  scale 1.000000 1.000000 1.000000
  light.color 0.980000 0.900000 1.000000
  light.intensity 1.100000

entity "Camera"
  parent 0
  position 0.000000 4.500000 -12.000000
  rotation 0.000000 0.000000 0.000000 1.000000
  scale 1.000000 1.000000 1.000000
  camera 1.047200 0.100000 100.000000 0 10.000000 1

entity "Ground"
  parent 0
  position 0.000000 0.000000 0.000000
  rotation 0.000000 0.000000 0.000000 1.000000
  scale 1.000000 1.000000 1.000000
  primitive plane 12.000000
  material.baseColor 0.360000 0.320000 0.480000
  material.outlineColor 0.090000 0.070000 0.130000
  material.outlineWidth 0.020000
  material.bands 4.000000
  material.ambient 0.250000
  material.roughness 0.800000
  collider box 12.000000 0.100000 12.000000

entity "Return Door"
  parent 0
  position 5.000000 1.000000 0.000000
  rotation 0.000000 0.000000 0.000000 1.000000
  scale 1.000000 1.000000 1.000000
  primitive cube 1.000000
  material.baseColor 0.950000 0.550000 0.150000
  material.outlineColor 0.200000 0.090000 0.010000
  material.outlineWidth 0.035000
  material.bands 4.000000
  material.ambient 0.280000
  material.roughness 0.600000
  collider box 1.000000 1.000000 1.000000
  script LevelExit default.scene

entity "Ball"
  parent 0
  position 0.000000 6.000000 0.000000
  rotation 0.000000 0.000000 0.000000 1.000000
  scale 1.000000 1.000000 1.000000
  primitive sphere 0.500000 24 32
  material.baseColor 0.400000 0.850000 0.950000
  material.outlineColor 0.050000 0.170000 0.200000
  material.outlineWidth 0.030000
  material.bands 4.000000
  material.ambient 0.250000
  material.roughness 0.500000
  collider sphere 0.500000 0.000000 0.000000
  rigidbody dynamic 1.000000 0.500000 0.250000

entity "Landmark"
  parent 0
  position -4.500000 1.200000 2.000000
  rotation 0.000000 0.000000 0.000000 1.000000
  scale 1.000000 1.000000 1.000000
  primitive cube 1.200000
  material.baseColor 0.930000 0.880000 0.350000
  material.outlineColor 0.200000 0.180000 0.040000
  material.outlineWidth 0.030000
  material.bands 4.000000
  material.ambient 0.250000
  material.roughness 0.500000
