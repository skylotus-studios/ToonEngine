---
# .clang-format — ToonEngine house style
# Requires clang-format 15+ (for InsertBraces); CLion's bundled clang-format ships
# newer. CLion auto-detects this file — Settings > Editor > Code Style > Enable
# ClangFormat.
#
# Base style is LLVM; only deviations are listed below. Everything else:
# https://clang.llvm.org/docs/ClangFormatStyleOptions.html
Language: Cpp
BasedOnStyle: LLVM
Standard: Latest

# ---- Core layout ------------------------------------------------------------
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 120

# K&R — opening braces attached: `void f() {`
BreakBeforeBraces: Attach

# Indent namespace contents; label closing braces `} // namespace ToonEngine`
NamespaceIndentation: All
FixNamespaceComments: true

# `public:` / `private:` sit flush with the `class` keyword
AccessModifierOffset: -4

# `case` labels indented one level inside `switch`
IndentCaseLabels: true

# ---- Pointers & references ----------------------------------------------------
# C classic: `int *ptr`
PointerAlignment: Right
DerivePointerAlignment: false

# ---- Short constructs on one line ----------------------------------------------
# Trivial bodies may stay inline: `int getX() { return x; }`
AllowShortFunctionsOnASingleLine: All
AllowShortLambdasOnASingleLine: All

# Braces are mandatory everywhere — clang-format auto-inserts any that are
# missing. (This is a syntax-driven rewrite; in exotic macro-heavy code,
# eyeball the result.)
InsertBraces: true

# ...but a tiny braced guard may still collapse onto one line:
#     if (!ptr) { return; }
# Requires BOTH options below. Note this also lets other tiny braced blocks
# (e.g. `while (pump()) { step(); }`) collapse.
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortBlocksOnASingleLine: Always

# ---- Vertical alignment: none (clean diffs, useful git blame) ------------------
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None

# ---- Includes: never reordered ---------------------------------------------------
# Ordering stays exactly as written, so order-sensitive headers are safe.
SortIncludes: Never
